# Salin file ini menjadi .env lalu sesuaikan isinya.

# Koneksi PostgreSQL. Untuk layanan cloud (Neon, Supabase, dst.) tambahkan ?sslmode=require
DATABASE_URL=

# Alamat situs tanpa garis miring di akhir. Dipakai untuk sitemap, tautan berbagi, dan file kalender.
# Saat sudah tayang, ganti menjadi https://projectkonser.id
SITE_URL=

# Feach data dari Youtube.
YOUTUBE_API_KEY=

# ImageKit: tempat semua gambar disimpan. Kunci privat ada di dasbor ImageKit,
# menu Developer options > API keys. Jangan bagikan kunci ini dan jangan beri awalan NEXT_PUBLIC_.
IMAGEKIT_PRIVATE_KEY=
# Folder tujuan di ImageKit (boleh diganti).
IMAGEKIT_FOLDER=

# Dua akun admin, dibuat saat `npm run db:setup` dijalankan.
# Ganti email dengan alamat yang benar. Kata sandi awal keduanya sama; ganti setelah masuk.
ADMIN_1_NAME=
ADMIN_1_EMAIL=
ADMIN_2_NAME=
ADMIN_2_EMAIL=
ADMIN_PASSWORD=

# Lama minimum kerangka pemuatan (skeleton) di halaman publik, dalam milidetik. 0 untuk mematikan.
SKELETON_MS=
